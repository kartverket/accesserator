{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Oslo",
  "schedule": ["before 08:00 on monday"],
  "enabledManagers": ["kustomize", "dockerfile", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/config/manager/base/.env$/"],
      "matchStrings": [
        "_IMAGE_NAME=(?<depName>.+?)\\s*\\n.*_IMAGE_TAG=(?<currentValue>.+?)\\s*\\n.*_IMAGE_SHA=(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/nais/**"],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})-(?<build>\\d{6})-\\w+$"
    },
    {
      "matchPackageNames": ["ghcr.io/nais/**", "openpolicyagent/opa"],
      "pinDigests": true
    }
  ]
}
